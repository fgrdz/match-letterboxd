TMDB_API_KEY=
LETTERBOXD_TRANSPORT=direct
# To use Web Unlocker: set LETTERBOXD_TRANSPORT=brightdata and fill both values.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
BRIGHTDATA_TIMEOUT_MS=60000
BRIGHTDATA_MAX_REQUESTS_PER_HOUR=100
LETTERBOXD_MAX_PAGES=
LETTERBOXD_REQUEST_DELAY_MS=600
LETTERBOXD_TIMEOUT_MS=15000
LETTERBOXD_USER_AGENT=LetterboxdMatch/0.1 (personal non-commercial comparison)
CACHE_TTL_SECONDS=3600
TMDB_MAX_MOVIES=18
# Independent genre sample per profile; 0 analyzes the full collected filmography.
TMDB_GENRE_SAMPLE_SIZE=300
# Common movies enriched first for the shared-genre browser.
TMDB_GENRE_COMMON_LIMIT=300
# Stop optional genre enrichment after this budget; interrupted analyses do not affect match.
TMDB_GENRE_TIME_BUDGET_MS=240000
